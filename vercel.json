{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://mcp-shield-gateway-core.vercel.app; img-src 'self' data: https:;" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/evaluate", "destination": "/api/evaluate" },
    { "source": "/api/keys/:match*", "destination": "/api/index" },
    { "source": "/api/keys", "destination": "/api/index" },
    { "source": "/api/audit/:match*", "destination": "/api/index" },
    { "source": "/api/telemetry/:match*", "destination": "/api/index" },
    { "source": "/api/registry", "destination": "/api/index" },
    { "source": "/api/stats", "destination": "/api/index" },
    { "source": "/v1/mcp", "destination": "/api/mcp" },
    { "source": "/v1/audit/logs", "destination": "/api/index" },
    { "source": "/v1/registry/tools", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/api/:match*", "destination": "/api/index" }
  ]
}
