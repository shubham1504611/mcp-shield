# ==============================================================================
# MCP SHIELD PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=8080

# 1. Supabase PostgreSQL 15 Database (With Connection Pooling)
# Get from: Supabase Project Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. Dodo Payments (Merchant of Record Rails)
# Get from: Dodo Payments Dashboard -> Developer API Keys
DODO_PAYMENTS_API_KEY=dodo_live_api_key_xxxxxxxxxxxxxxxx
DODO_WEBHOOK_SECRET=dodo_whsec_xxxxxxxxxxxxxxxx
DODO_CHECKOUT_SUCCESS_URL=https://dashboard.yourdomain.com/?checkout=success

# 3. Security Attestation & Enclave Keys
# ed25519 Hardware Signing Key (Base64 PKCS#8)
MCP_ATTESTATION_PRIVATE_KEY=
