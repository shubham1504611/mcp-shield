# ==============================================================================
# MCP SHIELD PLATFORM CONFIGURATION
# ==============================================================================

# Supabase / PostgreSQL Enterprise Persistent Storage
# (When omitted, the gateway defaults to zero-dependency in-memory resilient mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cryptographic HMAC Pepper for API Key Hashing (Keep Secret!)
MCP_KEY_PEPPER=your-random-32-byte-hex-pepper-string-keep-secret

# Master Admin Secret for Provisioning Production Tier API Keys (>= 16 characters)
MCP_ADMIN_SECRET=your-strong-random-admin-secret-at-least-16-chars

# Custom Ed25519 Private Key PEM (Optional - gateway generates secure enclave key if omitted)
# MCP_ATTESTATION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Allowed CORS Origins
ALLOWED_ORIGINS=https://mcp-shield-gateway-core.vercel.app,http://localhost:3000,http://127.0.0.1:3000
