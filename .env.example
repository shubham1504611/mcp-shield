# MCP Shield Gateway Environment Configuration

# Server Port (Local Proxy Mode)
PORT=8080

# Environment Mode
NODE_ENV=production

# (Optional) Deterministic Custom Ed25519 Attestation Signing Keys
# If unset, MCP Shield automatically generates a secure cryptographic keypair in-memory.
# MCP_ATTESTATION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MCP_ATTESTATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS="https://mcp-shield-gateway-core.vercel.app,http://localhost:3000,http://127.0.0.1:8080"
